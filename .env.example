# Copy to .env and fill in ONE key. Never commit the real .env file.
# The provider is auto-detected from whichever key you fill in (or from the key's prefix
# when passed with --api-key). Models fall back automatically if one is unavailable.

# --- Google Gemini (https://aistudio.google.com/apikey) -------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# --- Anthropic Claude (https://console.anthropic.com/settings/keys) -------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com          # optional: proxy / gateway

# --- OpenAI (https://platform.openai.com/api-keys) -----------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1             # optional: Azure/OpenRouter/other OpenAI-compatible gateway

# --- Groq (https://console.groq.com/keys) --------------------------------------------
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: force a backend (gemini | anthropic | openai | groq). Leave commented to auto-detect.
# If several keys are set and this is unset, the order is gemini, anthropic, openai, groq.
# LLM_PROVIDER=anthropic
